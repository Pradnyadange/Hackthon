# Database Connection URL (PostgreSQL or SQLite file)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edumatrix?schema=public"

# Authentication Secrets
JWT_SECRET="your_jwt_secret_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key"

# Server Port
PORT=5000

# Document File Storage Settings
STORAGE_URL="http://localhost:5000/uploads"
STORAGE_API_KEY="your_storage_api_key"

# AI / OCR Document Reader API Key (Leave empty to use Mock OCR Engine)
AI_API_KEY=""
